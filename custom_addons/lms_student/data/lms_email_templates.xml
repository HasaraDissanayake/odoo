        <field name="email_to">${object.student_id.email}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;">
    <div style="background-color: #2c7be5; padding: 24px; text-align: center;">
        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Course Now Available</h1>
    </div>
    <div style="padding: 32px; background-color: #ffffff;">
        <p style="font-size: 16px; color: #333;">Dear <strong>${object.student_id.name}</strong>,</p>
        <p style="color: #555;">Great news! The following course you are enrolled in is now <strong>published and available</strong>:</p>
        <table style="width: 100%; border-collapse: collapse; margin: 24px 0;">
            <tr style="background-color: #f5f8ff;">
