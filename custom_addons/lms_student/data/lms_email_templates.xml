                <td style="padding: 10px 14px; color: #333; font-weight: bold;">${object.course_id.name}</td>
            </tr>
            <tr>
                <td style="padding: 10px 14px; color: #888;">Course Code</td>
                <td style="padding: 10px 14px; color: #333;">${object.course_id.code}</td>
            </tr>
            <tr style="background-color: #f5f8ff;">
                <td style="padding: 10px 14px; color: #888;">Instructor</td>
