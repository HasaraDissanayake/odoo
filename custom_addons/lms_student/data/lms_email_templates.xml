            </tr>
            <tr>
                <td style="padding: 10px 14px; color: #888;">Start Date</td>
                <td style="padding: 10px 14px; color: #333;">${object.course_id.start_date or 'TBA'}</td>
            </tr>
            <tr style="background-color: #f5f8ff;">
                <td style="padding: 10px 14px; color: #888;">End Date</td>
                <td style="padding: 10px 14px; color: #333;">${object.course_id.end_date or 'TBA'}</td>
            </tr>
            <tr>
                <td style="padding: 10px 14px; color: #888;">Duration</td>
                <td style="padding: 10px 14px; color: #333;">${object.course_id.duration_weeks} weeks</td>
