<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!-- Attendance Line List View -->
    <record id="view_lms_attendance_line_tree" model="ir.ui.view">
        <field name="name">lms.attendance.line.tree</field>
        <field name="model">lms.attendance.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="student_id"/>
                <field name="course_id" optional="hide"/>
                <field name="date" optional="hide"/>
                <field name="status" widget="radio" options="{'horizontal': true}"/>
            </list>
        </field>
    </record>

    <!-- Attendance Session List View -->
    <record id="view_lms_attendance_session_tree" model="ir.ui.view">
        <field name="name">lms.attendance.session.tree</field>
        <field name="model">lms.attendance.session</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="course_id"/>
                <field name="date"/>
                <field name="lecturer_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Attendance Session Form View -->
    <record id="view_lms_attendance_session_form" model="ir.ui.view">
        <field name="name">lms.attendance.session.form</field>
        <field name="model">lms.attendance.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm Attendance" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="lecturer_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attendance Records" name="attendance_lines">
                            <field name="attendance_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Attendance Session Search View -->
    <record id="view_lms_attendance_session_search" model="ir.ui.view">
        <field name="name">lms.attendance.session.search</field>
        <field name="model">lms.attendance.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="course_id"/>
                <field name="lecturer_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Confirmed" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View for Attendance -->
    <record id="view_lms_attendance_session_calendar" model="ir.ui.view">
        <field name="name">lms.attendance.session.calendar</field>
        <field name="model">lms.attendance.session</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Sessions" date_start="date" color="course_id" mode="month">
                <field name="course_id"/>
                <field name="lecturer_id"/>
            </calendar>
        </field>
    </record>

    <!-- Attendance Session Action -->
    <record id="action_lms_attendance_session" model="ir.actions.act_window">
        <field name="name">Attendance Sessions</field>
        <field name="res_model">lms.attendance.session</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_lms_attendance_session_search"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Record a new attendance session
          </p>
          <p>
            Capture student presence for each course session.
          </p>
        </field>
    </record>
</data>
</odoo>
