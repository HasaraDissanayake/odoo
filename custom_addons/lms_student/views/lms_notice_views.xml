<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Notice standalone form (used as popup from the course tab) -->
        <record id="view_lms_course_notice_form" model="ir.ui.view">
            <field name="name">lms.course.notice.form</field>
            <field name="model">lms.course.notice</field>
            <field name="arch" type="xml">
                <form string="Notice">
                    <header>
                        <button name="action_publish" type="object"
                                string="Publish &amp; Notify Students"
                                class="oe_highlight"
                                invisible="state == 'published'"
                                groups="lms_student.group_lms_manager"/>
                        <button name="action_reset_draft" type="object"
                                string="Reset to Draft"
                                invisible="state == 'draft'"
                                groups="lms_student.group_lms_manager"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,published"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="title"/>
                            <h1>
                                <field name="title" placeholder="Notice title..."/>
                            </h1>
                        </div>
                        <group>
                            <field name="author_id" readonly="1"/>
                            <field name="published_date" readonly="1"/>
                        </group>
                        <separator string="Content"/>
                        <field name="content" placeholder="Write the notice content here..."/>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
