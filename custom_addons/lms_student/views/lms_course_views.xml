<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Course FORM View -->
        <record id="view_lms_course_form" model="ir.ui.view">
            <field name="name">lms.course.form</field>
            <field name="model">lms.course</field>
            <field name="arch" type="xml">
                <form string="Course">
                    <header>
                        <button name="action_publish" type="object"
                                string="Publish" class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_archive_course" type="object"
                                string="Archive"
                                invisible="state != 'published'"/>
                        <button name="action_reset_draft" type="object"
                                string="Reset to Draft"
                                invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,published,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Course Name"/>
                            </h1>
                            <div>
                                <strong>Code: </strong>
                                <field name="code" placeholder="e.g. CS101"/>
                            </div>
                        </div>
                        <group>
                            <group string="Course Details">
                                <field name="category"/>
                                <field name="credits"/>
                                <field name="duration_weeks"/>
                                <field name="max_students"/>
                                <field name="enrolled_count"
                                       string="Currently Enrolled" readonly="1"/>
                            </group>
                            <group string="Schedule and Instructor">
                                <field name="instructor_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"
                                       placeholder="Course description..."/>
                            </page>
                            <page string="Enrolled Students">
                                <field name="enrollment_ids">
                                    <list string="Students" editable="bottom">
                                        <field name="student_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'enrolled'"
                                               decoration-info="state == 'completed'"
                                               decoration-warning="state == 'pending'"
                                               decoration-danger="state == 'dropped'"/>
                                        <field name="grade"/>
                                        <field name="attendance_percent"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Course LIST View -->
        <record id="view_lms_course_list" model="ir.ui.view">
            <field name="name">lms.course.list</field>
            <field name="model">lms.course</field>
            <field name="arch" type="xml">
                <list string="Courses">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category"/>
                    <field name="instructor_id"/>
                    <field name="credits"/>
                    <field name="enrolled_count" string="Enrolled"/>
                    <field name="max_students" string="Capacity"/>
                    <field name="start_date"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'published'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'archived'"/>
                </list>
            </field>
        </record>

        <!-- Course SEARCH View -->
        <record id="view_lms_course_search" model="ir.ui.view">
            <field name="name">lms.course.search</field>
            <field name="model">lms.course</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="instructor_id"/>
                    <filter name="published" string="Published" domain="[('state','=','published')]"/>
                </search>
            </field>
        </record>

        <!-- Course ACTION -->
        <record id="action_lms_course" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">lms.course</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_lms_course_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first course!
                </p>
            </field>
        </record>

    </data>
</odoo>
