<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ════════════  TOP-LEVEL MENU  ════════════ -->
        <menuitem id="menu_lms_root"
                  name="LMS"
                  sequence="50"/>

        <!-- ════════════  DASHBOARD  ════════════ -->
