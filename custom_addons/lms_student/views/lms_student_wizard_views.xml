<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ═══════════════════════════════════════════════════
         WIZARD FORM — opens as a dialog popup
    ═══════════════════════════════════════════════════ -->
    <record id="view_lms_student_wizard_form" model="ir.ui.view">
        <field name="name">lms.student.wizard.form</field>
        <field name="model">lms.student.wizard</field>
        <field name="arch" type="xml">
            <form string="Add New Student">
                <sheet>

                    <!-- ── Coloured header banner ── -->
                    <div style="background:#1565C0; border-radius:8px 8px 0 0;
                                padding:14px 20px; margin:-16px -16px 20px -16px; color:#fff;">
                        <div style="font-size:18px; font-weight:700; margin-bottom:4px;">
                            &#127891; Add New Student
                        </div>
                        <div style="font-size:13px; opacity:0.85;">
                            Fill in the student details below and click Create Student.
                        </div>
                    </div>

                    <!-- ── Photo + Name row ── -->
                    <div style="display:flex; align-items:flex-start; gap:20px; margin-bottom:16px;">
                        <field name="image" widget="image"
                               style="width:96px; height:96px; border-radius:8px;
                                      border:1px solid #ddd; flex-shrink:0;"/>
                        <div style="flex:1;">
                            <label for="name" style="font-weight:600; color:#555;
                                                      font-size:12px; display:block; margin-bottom:4px;">
                                Full Name *
                            </label>
                            <field name="name" placeholder="e.g. John Smith"
                                   style="font-size:18px; font-weight:600;"/>
                            <div style="margin-top:6px; font-size:12px; color:#888;
                                        display:flex; align-items:center; gap:6px;">
                                <span style="font-weight:600; color:#1565C0;">Student ID:</span>
                                <span style="background:#e3f2fd; color:#1565C0; border-radius:4px;
                                             padding:2px 10px; font-weight:600; letter-spacing:0.5px;">
                                    Auto-assigned on save
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- ── Personal Information ── -->
                    <div style="background:#f0f4ff; border-radius:6px; padding:12px 16px;
                                margin-bottom:16px; border-left:4px solid #1565C0;">
                        <div style="font-size:13px; font-weight:700; color:#1565C0;
                                    margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">
                            Personal Information
                        </div>
                        <group>
                            <group>
                                <field name="date_of_birth"/>
                                <field name="gender"/>
                            </group>
                            <group>
                                <field name="nationality"/>
                                <field name="enrollment_date"/>
                            </group>
                        </group>
                    </div>

                    <!-- ── Contact Details ── -->
                    <div style="background:#f0fff4; border-radius:6px; padding:12px 16px;
                                margin-bottom:16px; border-left:4px solid #2e7d32;">
                        <div style="font-size:13px; font-weight:700; color:#2e7d32;
                                    margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">
                            Contact Details
                        </div>
                        <group>
                            <group>
                                <field name="email" placeholder="student@example.com"/>
                                <field name="phone" placeholder="+94 77 000 0000"/>
                            </group>
                            <group>
                                <field name="mobile" placeholder="+94 77 000 0000"/>
                                <field name="user_id" options="{'no_create': True}"
                                       placeholder="Link portal account…"/>
                            </group>
                        </group>
                        <group>
                            <field name="address" placeholder="Home address…" nolabel="0"/>
                        </group>
                    </div>

                    <!-- ── Guardian Information ── -->
                    <div style="background:#fff8f0; border-radius:6px; padding:12px 16px;
                                border-left:4px solid #e65100;">
                        <div style="font-size:13px; font-weight:700; color:#e65100;
                                    margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">
                            Guardian Information
                        </div>
                        <group>
                            <group>
                                <field name="guardian_name"  placeholder="Parent / Guardian name"/>
                                <field name="guardian_phone" placeholder="+94 77 000 0000"/>
                            </group>
                            <group>
                                <field name="guardian_email" placeholder="parent@example.com"/>
                            </group>
                        </group>
                    </div>

                </sheet>

                <!-- ── Dialog footer ── -->
                <footer>
                    <button name="action_create_student"
                            type="object"
                            string="Create Student"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action that opens the wizard as a dialog -->
    <record id="action_lms_student_wizard" model="ir.actions.act_window">
        <field name="name">Add New Student</field>
        <field name="res_model">lms.student.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</data>
</odoo>
