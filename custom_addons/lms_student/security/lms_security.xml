            <field name="model_id" ref="model_lms_fee_payment"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('lms_student.group_lms_manager'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ══════════════════════════════════════════════════════════════════
             RECORD RULES — Predictive Analytics (lms.predictive.analytics)
             ▸ Students : own prediction record only
             ▸ Teachers : only students enrolled in their courses
             ▸ Managers : all records, full control
        ══════════════════════════════════════════════════════════════════ -->

        <record id="lms_rule_predictive_student" model="ir.rule">
            <field name="name">LMS Prediction: student sees own record only</field>
            <field name="model_id" ref="model_lms_predictive_analytics"/>
            <field name="domain_force">[('student_id.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_student.group_lms_student'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="lms_rule_predictive_teacher" model="ir.rule">
            <field name="name">LMS Prediction: teacher sees students in their courses</field>
            <field name="model_id" ref="model_lms_predictive_analytics"/>
            <field name="domain_force">[('student_id.enrollment_ids.course_id.instructor_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_student.group_lms_teacher'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="lms_rule_predictive_manager" model="ir.rule">
            <field name="name">LMS Prediction: manager sees all records</field>
            <field name="model_id" ref="model_lms_predictive_analytics"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('lms_student.group_lms_manager'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
